# ==========================================
# CollabFlow - Git Ignore Configuration
# Frontend Only (Backend & Secrets Excluded)
# ==========================================

# 1. Entire Backend, Database & Server Code (Confidential)
server/
/server/
backend/
/backend/
api/
/api/

# 2. Database, Migrations, Seeds & Schemas
*.prisma
*.sql
*.sqlite
*.sqlite-journal
*.db

# 3. Environment and Secret Files (Never commit credentials)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.local
*.pem
*.key
*.cert

# Allow safe example config templates
!.env.example
!client/.env.example

# 4. Dependencies
node_modules/
*/node_modules/
.pnp
.pnp.js

# 5. Production Build Outputs
dist/
*/dist/
dist-ssr/
build/
out/
.next/
*.tsbuildinfo

# 6. Logs & Debugging Files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 7. IDE, System & Temporary Files
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
