# ==========================================
# CollabFlow - Git Ignore Configuration
# Frontend Only (Backend & Secrets Excluded)
# ==========================================

# 1. Backend Server Directory (Excluded entirely from repository)
server/
/server/

# 2. Environment and Secret Files (Never commit credentials)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.local

# Allow example config templates
!.env.example
!client/.env.example

# 3. Dependencies
node_modules/
*/node_modules/
.pnp
.pnp.js

# 4. Production Build Outputs
dist/
*/dist/
dist-ssr/
build/
out/
.next/

# 5. Database & Cache Files
*.sqlite
*.sqlite-journal
*.db
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 6. IDE, System & Temporary Files
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.tsbuildinfo
